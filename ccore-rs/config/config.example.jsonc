{
    // Use o token de uma aplicacao de TESTE. O registro por servidor substitui
    // TODOS os comandos daquela aplicacao ali: com o token de producao, esta
    // versao apagaria os comandos que ainda nao foram portados.
    "token": "",
    "prefix": "-",
    "guildIds": [],
    // Cargo de staff: quem nao tem nao usa /logs, /checkspreadsheetinfo e /enlistuser.
    "enlistPermissionRoleId": null,
    // Link do jogo que o /dmdeployment manda junto da DM.
    "defaultGameLink": null,
    // Canais do alistamento. Sem o de logs ou o de boas-vindas, o anuncio e pulado.
    "enlistLogChannelId": null,
    "enlistWelcomeChannelId": null,
    // Cargos que todo alistado recebe.
    "enlistTargetRoleIds": [],
    "enlistSocialRoleId": null,
    // O /alistar-se so roda neste canal, e quem tem um destes cargos e recusado.
    "robloxEnlistChannelId": null,
    "robloxEnlistBlockedRoleIds": [],
    // CSV publicado de cada aba. promotions: mostra "antiga -> nova".
    "spreadsheetInfoTabs": [
        // { "name": "Efetivo", "csvUrl": "https://docs.google.com/...", "promotions": false }
    ],
    // /deployment: quem pode usar, onde posta e quem e pingado.
    "deploymentChannelId": null,
    "deploymentAllowedRoleIds": [],
    "deploymentDefaultRoles": [],
    "deploymentGameLink": null,
    "deploymentVoiceChatLink": null,
    "deploymentTitle": null,
    "deploymentVoiceChannel": null,
    "deploymentImageUrl": null,
    "deploymentPlaceId": null,
    // CODE_HERE ou {CODE} viram o codigo digitado.
    "deploymentQuickLaunchLink": null,
    // Guarda as mensagens recentes de um canal e reposta uma de vez em quando.
    "messageReposting": {
        "enabled": false,
        "targetChannelId": 0,
        "repostIntervalMinutes": 60,
        "messageRetentionHours": 24,
        "minimumMessagesForRepost": 50
    },
    // Termos que geram resposta e alerta por DM. {mention}, {user}, {term} e
    // {channel} sao trocados na resposta.
    "messageBlacklist": {
        "enabled": false,
        "blacklistedTerms": [],
        "responseMessage": "",
        "responseMessage2Terms": [],
        "responseMessage2": null,
        "notifyUserIds": [],
        "dmAlertCooldownMinutes": 5
    },
    // Auditoria (/audit-*). Em teste, aponte para um repositorio de TESTE: o
    // /audit-push grava commits na branch configurada.
    "audit": {
        // Vazio usa GH_TOKEN ou o login do `gh` CLI da maquina.
        "githubToken": null,
        "githubOwner": null,
        "githubRepo": null,
        "githubBranch": "audit-data",
        "auditFilePath": "audit.json",
        "archiveDirectory": "audits",
        "auditCsvUrl": null,
        "csvHeaderRows": 1,
        "csvColumns": { "username": 0, "rank": 1, "battles": 2, "kills": -1, "deaths": -1, "assists": -1 }
    }
}
